{
  "name": "automation-exercise-playwright-typescript",
  "version": "1.0.0",
  "description": "Complete E-Commerce Automation using TypeScript & Playwright with Page Object Model",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
