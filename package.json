  "keywords": ["playwright", "typescript", "automation", "e2e", "testing", "pom"],
  "author": "Amit Chaurasiya",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0"
  }
}